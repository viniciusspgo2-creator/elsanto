# PostgreSQL (Neon, Supabase Postgres or local Docker)
DATABASE_URL="postgresql://elsanto:elsanto@localhost:5432/elsanto?schema=public"
# Minimum 32 random chars. Generate: openssl rand -base64 48
AUTH_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET_32_PLUS_CHARACTERS"
# Used by prisma db:seed only, not hard-coded into source
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional. No charges until explicitly enabled in admin and keys configured.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Opcional — modo delivery por KM (ambos HTTPS e contratados/autohospedados)
# Nominatim-compatible: endpoint para geocodificação; NÃO usar servidores públicos de demonstração na produção.
GEOCODER_BASE_URL=""
# OSRM-compatible: URL base do servidor de rotas HTTPS (ex.: https://rotas.seudominio.com)
ROUTER_BASE_URL=""

# Opcional — imagens enviadas do painel para Cloudflare R2 / S3 compatível.
# Configure o bucket com CORS permitindo PUT da origem do site e GET no domínio público.
# Nunca exponha as chaves no frontend ou com prefixo NEXT_PUBLIC_.
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="auto"
S3_PUBLIC_BASE_URL=""
